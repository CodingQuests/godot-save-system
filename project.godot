; Engine configuration file.
; Godot Save System
; Slot-based JSON saves with atomic writes, versioning and a "persist" group
; pattern. The demo: pick up potions, open a chest, save to three slots, load.
; Open this folder in Godot 4.7+ and press F5.

config_version=5

[application]

config/name="Godot Save System"
config/description="A slot-based save and load system for Godot 4 with persistent world objects. From codingquests.io"
run/main_scene="res://demo/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/kenney_tiny-dungeon/tile_0089.png"

[autoload]

SaveManager="*res://save_system/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

